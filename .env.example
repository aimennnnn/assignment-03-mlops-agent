# Copy this file to .env and fill in the values. The real .env is never saved in Git.

# Airflow login (used by docker-compose.yml and by the agent's Airflow tools)
AIRFLOW_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me

# Language model for the agent: any provider with the standard chat-completions API
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=paste-your-key-here
